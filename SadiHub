	local camLivreAtiva = false       -- câmera própria (giro livre, até 360° na vertical)
	local primeiraPessoa = false      -- cursor travado no centro o tempo todo
	local voltarMouse = true          -- devolve o mouse pra onde estava ao soltar
	local vertical360 = false         -- câmera livre sem limite vertical
	local inverterY = false
	local posX, posY = 50, 35         -- posição escolhida (% da tela)
	local velBorda = 140              -- graus por segundo (giro nas bordas)
	local margemBorda = 3             -- px da borda que contam como "encostou"
	local sensUsuario = 100           -- % (slider de sensibilidade)

	-- ====================== ESTADO ======================
	local travado = false
	local posSalva = nil
	local esperaFrames = 0
	local sensOriginal = nil
	local bordaArmada = false
	local somaDelta = Vector2.new(0, 0)

	-- câmera livre
	local livreAtiva = false
	local tipoCamOriginal = nil
	local yawL, pitchL, distL = 0, 0, 10
	local focoOffset = Vector3.new(0, 0, 0)

	-- seletor de posição
	local seletorGui = nil
	local marcador = nil
	local mostrarMarcador = false
	local definirX, definirY

	local function cam() return workspace.CurrentCamera end
	local function temMoverMouse() return type(mousemoveabs) == "function" end

	local function aplicarSens(mult)
		if not sensOriginal then sensOriginal = UserInputService.MouseDeltaSensitivity end
		pcall(function() UserInputService.MouseDeltaSensitivity = sensOriginal * mult end)
	end

	local function comportamentoDesejado()
		if primeiraPessoa or metodo == 2 then return Enum.MouseBehavior.LockCenter end
		return Enum.MouseBehavior.LockCurrentPosition
	end

	-- ====================== CÂMERA ======================
	-- gira a câmera em volta do ponto de foco (usado no giro das bordas)
	local function girarCamera(dyaw, dpitch)
		local c = cam()
		local cf = c.CFrame
		local foco = c.Focus.Position
		local dist = (cf.Position - foco).Magnitude
		local rx, ry = cf:ToOrientation()
		local pitch = math.clamp(rx - dpitch, -1.45, 1.45)
		local rot = CFrame.fromOrientation(pitch, ry - dyaw, 0)
		c.CFrame = CFrame.new(foco - rot.LookVector * dist) * rot
	end

	local function iniciarLivre()
		local c = cam()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local rx, ry = c.CFrame:ToOrientation()
		pitchL, yawL = rx, ry
		distL = (c.CFrame.Position - c.Focus.Position).Magnitude
		focoOffset = hrp and (c.Focus.Position - hrp.Position) or Vector3.new(0, 0, 0)
		tipoCamOriginal = c.CameraType
		c.CameraType = Enum.CameraType.Scriptable
		livreAtiva = true
	end

	local function finalizarLivre()
		if not livreAtiva then return end
		livreAtiva = false
		local c = cam()
		pcall(function() c.CameraType = tipoCamOriginal or Enum.CameraType.Custom end)
		tipoCamOriginal = nil
	end

	local function atualizarLivre(d)
		local k = 0.0035
		yawL = yawL - d.X * k
		pitchL = pitchL - d.Y * k * (inverterY and -1 or 1)
		if vertical360 then
			if pitchL > math.pi then pitchL = pitchL - 2 * math.pi end
			if pitchL < -math.pi then pitchL = pitchL + 2 * math.pi end
		else
			pitchL = math.clamp(pitchL, -1.45, 1.45)
		end

		local c = cam()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local foco = hrp and (hrp.Position + focoOffset) or c.Focus.Position
		local rot = CFrame.fromOrientation(pitchL, yawL, 0)
		c.CFrame = CFrame.new(foco - rot.LookVector * distL) * rot
		c.Focus = CFrame.new(foco)
	end

	-- ====================== TRAVA DO CURSOR ======================
	local function soltar()
		finalizarLivre()
		if travado then
			travado = false
			esperaFrames = 0
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			aplicarSens(sensUsuario / 100)
			-- devolve o mouse pra onde ele estava antes de travar
			if voltarMouse and posSalva and temMoverMouse() then
				pcall(mousemoveabs, posSalva.X, posSalva.Y)
			end
			posSalva = nil
		end
	end

	-- pra onde o mouse deve ir (em pixels da tela); nil = não mover
	local function alvoDoMouse()
		local tela = cam().ViewportSize
		if modo == 1 and posSalva then
			return tela.X / 2, math.clamp(posSalva.Y, 5, tela.Y - 5)
		elseif modo == 3 then
			return tela.X * posX / 100, tela.Y * posY / 100
		end
		return nil
	end

	local function algumaTravaAtiva()
		return antiLimiteAtivo or semLimiteAtivo or camLivreAtiva or primeiraPessoa
	end

	conectar(RunService.RenderStepped, function(dt)
		if not (algumaTravaAtiva() or bordasAtivo) then return end

		-- só age se o dispositivo está reconhecendo o mouse
		if not UserInputService.MouseEnabled then return end

		local girando = primeiraPessoa
			or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

		if not girando then
			-- soltou o botão direito: libera o cursor e volta pro lugar de antes
			soltar()
			bordaArmada = false
			return
		end

		-- ---------- giro nas bordas (quando o cursor não está sendo travado por nós) ----------
		if bordasAtivo and not algumaTravaAtiva() then
			local pos = UserInputService:GetMouseLocation()
			local tela = cam().ViewportSize
			local nx = (pos.X <= margemBorda) and -1 or ((pos.X >= tela.X - margemBorda) and 1 or 0)
			local ny = (pos.Y <= margemBorda) and -1 or ((pos.Y >= tela.Y - margemBorda) and 1 or 0)
			if nx == 0 and ny == 0 then
				bordaArmada = true -- o cursor já esteve longe da borda neste giro
			elseif bordaArmada then
				local v = math.rad(velBorda) * dt
				girarCamera(nx * v, -ny * v)
			end
			return
		end

		-- ---------- trava do cursor ----------
		if not travado then
			travado = true
			posSalva = UserInputService:GetMouseLocation()
			esperaFrames = 0

			if primeiraPessoa then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			elseif antiLimiteAtivo and metodo == 1 and temMoverMouse() and alvoDoMouse() then
				-- leva o mouse até a posição escolhida SEM girar a câmera (sensibilidade zerada),
				-- e só depois trava. Fica em "Default" nesses frames pra o jogo não puxar o cursor de volta.
				local x, y = alvoDoMouse()
				aplicarSens(0)
				pcall(mousemoveabs, x, y)
				esperaFrames = 3
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			else
				UserInputService.MouseBehavior = comportamentoDesejado()
			end
		elseif esperaFrames > 0 then
			esperaFrames = esperaFrames - 1
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			if esperaFrames == 0 then
				UserInputService.MouseBehavior = comportamentoDesejado()
				aplicarSens(sensUsuario / 100)
			end
		else
			-- mantém travado: o jogo às vezes tenta soltar o cursor no meio do giro,
			-- e é isso que faz o mouse bater na borda da tela e a câmera parar de virar
			local desejado = comportamentoDesejado()
			if UserInputService.MouseBehavior ~= desejado then
				UserInputService.MouseBehavior = desejado
			end

			if camLivreAtiva then
				if not livreAtiva then iniciarLivre() end
				atualizarLivre(UserInputService:GetMouseDelta())
			end
		end
	end)

	-- ====================== marcador / seletor de posição ======================
	local function garantirGui()
		if seletorGui and seletorGui.Parent then return seletorGui end
		seletorGui = Instance.new("ScreenGui")
		seletorGui.Name = "Sadi_Seletor"
		seletorGui.IgnoreGuiInset = true
		seletorGui.ResetOnSpawn = false
		seletorGui.DisplayOrder = 900
		seletorGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		seletorGui.Parent = playerGui
		return seletorGui
	end

	local function atualizarMarcador()
		local mostrar = mostrarMarcador and modo == 3
		if not mostrar then
			if marcador then marcador.Visible = false end
			return
		end
		local g = garantirGui()
		if not marcador or not marcador.Parent then
			marcador = Instance.new("Frame")
			marcador.Name = "Marcador"
			marcador.AnchorPoint = Vector2.new(0.5, 0.5)
			marcador.Size = UDim2.fromOffset(22, 22)
			marcador.BackgroundTransparency = 1
			marcador.ZIndex = 10
			marcador.Parent = g
			arredondar(marcador, 11)
			local st = Instance.new("UIStroke")
			st.Thickness = 2
			st.Parent = marcador
			local ponto = Instance.new("Frame")
			ponto.AnchorPoint = Vector2.new(0.5, 0.5)
			ponto.Position = UDim2.fromScale(0.5, 0.5)
			ponto.Size = UDim2.fromOffset(6, 6)
			ponto.BorderSizePixel = 0
			ponto.Parent = marcador
			arredondar(ponto, 3)
		end
		local cor = Temas[temaAtualNome].on
		marcador:FindFirstChildOfClass("UIStroke").Color = cor
		marcador:FindFirstChildOfClass("Frame").BackgroundColor3 = cor
		marcador.Position = UDim2.fromScale(posX / 100, posY / 100)
		marcador.Visible = true
	end

	local function escolherNaTela()
		local g = garantirGui()

		local ov = Instance.new("TextButton")
		ov.Name = "EscolherPosicao"
		ov.Size = UDim2.fromScale(1, 1)
		ov.BackgroundColor3 = Color3.new(0, 0, 0)
		ov.BackgroundTransparency = 0.55
		ov.AutoButtonColor = false
		ov.Text = "Clique (ou toque) onde o mouse deve ficar\n(Esc cancela)"
		ov.TextColor3 = Color3.new(1, 1, 1)
		ov.TextSize = 22
		ov.Font = Enum.Font.GothamBold
		ov.ZIndex = 100
		ov.Parent = g

		local cancelar
		local function fechar()
			if cancelar then cancelar:Disconnect() end
			if ov.Parent then ov:Destroy() end
		end

		cancelar = UserInputService.InputBegan:Connect(function(input)
			if input.KeyCode == Enum.KeyCode.Escape then fechar() end
		end)

		ov.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local tela = cam().ViewportSize
			local pos
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				pos = UserInputService:GetMouseLocation()
			else
				pos = input.Position + game:GetService("GuiService"):GetGuiInset()
			end
			posX = math.clamp(math.floor(pos.X / tela.X * 100 + 0.5), 0, 100)
			posY = math.clamp(math.floor(pos.Y / tela.Y * 100 + 0.5), 0, 100)
			if definirX then definirX(posX) end
			if definirY then definirY(posY) end
			atualizarMarcador()
			logar("info", string.format("Posição do mouse escolhida: %d%% / %d%% da tela.", posX, posY))
			fechar()
		end)
	end

	-- ====================== INTERFACE ======================
	criarCartao(pagina, "Mobilador", "Ferramentas de câmera e limite de tela. Use junto com o painel de diagnóstico lá embaixo pra ver o que está acontecendo.", 0)

	criarTitulo(pagina, "Tirar o limite de tela", 1)

	criarToggle(pagina, "Sem limite de câmera (mouse)", 2, function(on)
		semLimiteAtivo = on
		if on then
			logar("info", "Sem limite de câmera ativado: o cursor fica travado enquanto você gira a câmera.")
		else
			soltar()
			pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
			logar("info", "Sem limite de câmera desativado.")
		end
	end, false)

	criarToggle(pagina, "Giro nas bordas (nunca trava)", 3, function(on)
		bordasAtivo = on
		bordaArmada = false
		logar("info", on and "Giro nas bordas ativado: encostou na borda da tela, a câmera continua girando." or "Giro nas bordas desativado.")
	end, false)

	criarToggle(pagina, "Câmera livre 360° (BETA)", 4, function(on)
		camLivreAtiva = on
		if not on then
			soltar()
			pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
		end
		logar("info", on and "Câmera livre ativada: segure o botão direito pra girar sem limite." or "Câmera livre desativada.")
	end, false)

	criarToggle(pagina, "   ↳ Sem limite vertical (360° total)", 5, function(on)
		vertical360 = on
	end, false)

	criarToggle(pagina, "   ↳ Inverter eixo Y", 6, function(on)
		inverterY = on
	end, false)

	criarToggle(pagina, "Primeira pessoa (travar sempre)", 7, function(on)
		primeiraPessoa = on
		if not on then
			soltar()
			pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
		end
		logar("info", on and "Primeira pessoa ativada: cursor travado no centro." or "Primeira pessoa desativada.")
	end, false)

	criarTitulo(pagina, "Como travar o cursor", 8)
	VFX.seletor(pagina, 9, METODOS, metodo, function(i) metodo = i end)

	criarTitulo(pagina, "Giro nas bordas", 10)
	criarSlider(pagina, "Velocidade do giro", 11, 30, 400, velBorda, function(v) velBorda = v end, "°/s")
	criarSlider(pagina, "Margem da borda", 12, 1, 30, margemBorda, function(v) margemBorda = v end, " px")

	criarTitulo(pagina, "Posição do mouse ao girar", 13)

	criarToggle(pagina, "AntiLimite-de-Tela BETA", 14, function(on)
		antiLimiteAtivo = on
		if on then
			if not temMoverMouse() then
				logar("aviso", "AntiLimite-de-Tela: o executor não tem mousemoveabs, então o mouse trava onde você deixou (sem ir pra posição escolhida).")
			end
			logar("info", "AntiLimite-de-Tela BETA ativado.")
		else
			soltar()
			pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
			logar("info", "AntiLimite-de-Tela BETA desativado.")
		end
	end, false)

	criarToggle(pagina, "Voltar o mouse onde estava", 15, function(on)
		voltarMouse = on
	end, true)

	VFX.seletor(pagina, 16, MODOS, modo, function(i)
		modo = i
		atualizarMarcador()
	end)

	local _, dx = criarSlider(pagina, "Posição horizontal (X)", 17, 0, 100, posX, function(v)
		posX = v
		atualizarMarcador()
	end, "%")
	definirX = dx

	local _, dy = criarSlider(pagina, "Posição vertical (Y)", 18, 0, 100, posY, function(v)
		posY = v
		atualizarMarcador()
	end, "%")
	definirY = dy

	local botaoEscolher = criarBotao(pagina, "🎯  Escolher a posição clicando na tela", UDim2.new(1, 0, 0, 44), nil, 19, true)
	botaoEscolher.MouseButton1Click:Connect(escolherNaTela)

	criarToggle(pagina, "Mostrar marcador da posição", 20, function(on)
		mostrarMarcador = on
		atualizarMarcador()
	end, false)

	criarTitulo(pagina, "Sensibilidade", 21)
	criarSlider(pagina, "Sensibilidade da câmera", 22, 10, 300, sensUsuario, function(v)
		sensUsuario = v
		if not (travado and esperaFrames > 0) then aplicarSens(v / 100) end
	end, "%")

	criarTitulo(pagina, "Diagnóstico ao vivo", 23)
	criarCartao(pagina, "Mouse e câmera", "Aguardando...", 24)
	local statusCorpo = registroCartoes[#registroCartoes].corpo

	-- atualiza o diagnóstico 4x por segundo (só enquanto a aba está aberta)
	local ultimoStatus = 0
	conectar(RunService.RenderStepped, function()
		if janela.Visible and pagina.Visible then
			somaDelta = somaDelta + UserInputService:GetMouseDelta()
		end
		local agora = os.clock()
		if agora - ultimoStatus < 0.25 then return end
		local passou = agora - ultimoStatus
		ultimoStatus = agora
		if not (janela.Visible and pagina.Visible) then
			somaDelta = Vector2.new(0, 0)
			return
		end
		local pos = UserInputService:GetMouseLocation()
		local tela = cam().ViewportSize
		local naBorda = pos.X <= margemBorda or pos.Y <= margemBorda or pos.X >= tela.X - margemBorda or pos.Y >= tela.Y - margemBorda
		statusCorpo.Text = string.format(
			"Travado: %s  |  Behavior: %s\nMovimento: %d, %d px/s  |  Cursor: %d, %d\nNa borda: %s  |  Câmera livre: %s  |  mousemoveabs: %s",
			travado and "sim" or "não",
			UserInputService.MouseBehavior.Name,
			math.floor(math.abs(somaDelta.X) / passou), math.floor(math.abs(somaDelta.Y) / passou),
			math.floor(pos.X), math.floor(pos.Y),
			naBorda and "SIM" or "não",
			livreAtiva and "sim" or "não",
			temMoverMouse() and "sim" or "NÃO"
		)
		somaDelta = Vector2.new(0, 0)
	end)

	-- usado pelo Delete/Sair: devolve mouse, sensibilidade, câmera e remove o marcador
	function VFX.restaurarMouse()
		soltar()
		pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.Default end)
		if sensOriginal then
			pcall(function() UserInputService.MouseDeltaSensitivity = sensOriginal end)
		end
		if seletorGui then pcall(function() seletorGui:Destroy() end) end
	end
end)()

