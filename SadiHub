local function executarComando(texto)
	local cmd = string.lower(string.match(texto, "^%s*(.-)%s*$") or "")
	if cmd == "" then return end

	logar("info", "> " .. texto)

	if cmd == "delete" or cmd == "sair" then
		sairDoMenu()
	else
		logar("aviso", 'Comando desconhecido: "' .. cmd .. '". Comandos: Delete, Sair.')
	end
end

