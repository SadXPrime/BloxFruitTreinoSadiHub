local botoesAbas = {}
local abaAtual = "Início"
local COR_TEXTO_ABA_ATIVA = Color3.new(1, 1, 1)

local function selecionarAba(nome)
	abaAtual = nome
	for n, pag in pairs(paginas) do pag.Visible = (n == nome) end
	for n, btn in pairs(botoesAbas) do
		local selecionado = (n == nome)
		local tema = Temas[temaAtualNome]
		local skAba = btn:FindFirstChildOfClass("UIStroke")
		if skAba then
			TweenService:Create(skAba, TweenInfo.new(0.15), { Transparency = selecionado and 0.1 or 1 }):Play()
		end
		TweenService:Create(btn, TweenInfo.new(0.15), {
			BackgroundColor3 = selecionado and tema.on or tema.item,
			TextColor3 = selecionado and COR_TEXTO_ABA_ATIVA or tema.texto,
		}):Play()
	end

	-- se a barra de abas rola (tela pequena), mostra a aba escolhida
	local b = botoesAbas[nome]
	if b and barraAbas.AbsoluteCanvasSize.X > barraAbas.AbsoluteSize.X then
		local esquerda = b.AbsolutePosition.X - barraAbas.AbsolutePosition.X + barraAbas.CanvasPosition.X
		local direita = esquerda + b.AbsoluteSize.X
		local visivel = barraAbas.AbsoluteSize.X
		if direita > barraAbas.CanvasPosition.X + visivel then
			barraAbas.CanvasPosition = Vector2.new(direita - visivel + 6, 0)
		elseif esquerda < barraAbas.CanvasPosition.X then
			barraAbas.CanvasPosition = Vector2.new(math.max(0, esquerda - 6), 0)
		end
	end

	if VFX.aba then VFX.aba(nome) end
end

