local conexoesGlobais = {}
local guiRaiz = nil -- GUI desta execução (definida mais abaixo)
local function conectar(sinal, fn)
	local c
	c = sinal:Connect(function(...)
		-- se a GUI desta execução já foi destruída, essa conexão é de uma cópia velha: desliga
		if guiRaiz and not guiRaiz.Parent then
			c:Disconnect()
			return
		end
		return fn(...)
	end)
	table.insert(conexoesGlobais, c)
	return c
end

