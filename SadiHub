;(function()
	local pagina = paginas["Auto farm ETC"]
	local plr = player
	local TS = TweenService

	-- ====== coisas que o código original esperava de fora ======
	-- pasta das ilhas da raid (workspace._WorldOrigin.Locations)
	local function getLocations()
		local wo = workspace:FindFirstChild("_WorldOrigin")
		local loc = wo and wo:FindFirstChild("Locations")
