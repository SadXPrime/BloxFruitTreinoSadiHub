----------------------------------------------------------------
-- SORU AUTO AIM (escolhe o alvo e entrega a posição pro seu hook)
----------------------------------------------------------------
local soruAutoAimAtivo = false
local obterPosicaoSoru
;(function()
	local SORU_MODO = "360"            -- "360", "180" ou "FOV"
	local SORU_PRIORIDADE = "Nearest"  -- "Nearest", "Low HP" ou "Looking At Me"
	local SORU_FOV_RAIO = 100          -- só usado no modo "FOV"
	local SORU_TEAM_CHECK = false      -- true = ignora jogadores do seu time

	local soruAlcance = 300
	local alvoEscolhido = nil          -- nome do jogador escolhido; nil = automático
	local ultimaPos = nil
	local ultimaPosTempo = 0
	local ultimoCalculo = 0

	-- raiz do personagem (com fallback se não tiver HumanoidRootPart)
	local function raizDe(char)
		if not char then return nil end
		return char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
			or char.PrimaryPart
			or char:FindFirstChild("Head")
	end

	local function ehInimigo(p)
		if not p or p == player then return false end
		if SORU_TEAM_CHECK and p.Team and player.Team and p.Team == player.Team then return false end
		return true
	end

	local function alvoValido(hrp, meuHRP)
		if not hrp or not meuHRP then return false end

		if SORU_MODO == "180" then
			local dir = hrp.Position - meuHRP.Position
			if dir.Magnitude > 0 and meuHRP.CFrame.LookVector:Dot(dir.Unit) < 0 then
				return false
			end
		elseif SORU_MODO == "FOV" then
			local tela, naTela = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
			if not naTela then return false end
			local centro = workspace.CurrentCamera.ViewportSize / 2
			if (Vector2.new(tela.X, tela.Y) - centro).Magnitude > SORU_FOV_RAIO then
				return false
			end
		end
		return true
	end

	local function buscarAlvoSoru(meuHRP)
		-- jogador escolhido manualmente (só respeita o alcance máximo)
		if alvoEscolhido then
			local p = Players:FindFirstChild(alvoEscolhido)
			local char = p and p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = raizDe(char)
			if hum and hum.Health > 0 and hrp and (hrp.Position - meuHRP.Position).Magnitude <= soruAlcance then
				return hrp
			end
			return nil
		end

		-- automático
		local validos = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if ehInimigo(p) and p.Character and p.Character.Parent then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local hrp = raizDe(p.Character)
				if hum and hum.Health > 0 and hrp and alvoValido(hrp, meuHRP) then
					local dist = (hrp.Position - meuHRP.Position).Magnitude
					if dist <= soruAlcance then
						table.insert(validos, { HRP = hrp, Humanoid = hum, Distancia = dist })
					end
				end
			end
		end

		if #validos == 0 then return nil end

		if SORU_MODO == "FOV" then
			local centro = workspace.CurrentCamera.ViewportSize / 2
			local function distTela(e)
				local pt = workspace.CurrentCamera:WorldToViewportPoint(e.HRP.Position)
				return (Vector2.new(pt.X, pt.Y) - centro).Magnitude
			end
			table.sort(validos, function(a, b) return distTela(a) < distTela(b) end)
		elseif SORU_PRIORIDADE == "Low HP" then
			table.sort(validos, function(a, b) return a.Humanoid.Health < b.Humanoid.Health end)
		elseif SORU_PRIORIDADE == "Looking At Me" then
			local function olhandoPraMim(e)
				local dir = meuHRP.Position - e.HRP.Position
				if dir.Magnitude == 0 then return 1 end
				return e.HRP.CFrame.LookVector:Dot(dir.Unit)
			end
			table.sort(validos, function(a, b) return olhandoPraMim(a) > olhandoPraMim(b) end)
		else
			table.sort(validos, function(a, b) return a.Distancia < b.Distancia end)
		end

		return validos[1].HRP
	end

	-- posição do alvo: calculada NA HORA em que você chama (sempre fresca).
	-- se falhar por um instante, usa a última posição conhecida por até 0.5s.
	function obterPosicaoSoru()
		if not soruAutoAimAtivo then return nil end

		local char = player.Character
		local meuHRP = char and char:FindFirstChild("HumanoidRootPart")
		if meuHRP then
			local ok, raiz = pcall(buscarAlvoSoru, meuHRP)
			if ok and raiz then
				ultimaPos = raiz.Position
				ultimaPosTempo = os.clock()
				return ultimaPos
			end
		end

		if ultimaPos and os.clock() - ultimaPosTempo <= 0.5 then
			return ultimaPos
		end
		return nil
	end

	-- deixa a função disponível pro seu hook (se o executor tiver getgenv)
	pcall(function()
		local env = getgenv and getgenv()
		if env then env.SoruAutoAimPos = obterPosicaoSoru end
	end)

	-- mantém a última posição conhecida atualizada
	conectar(RunService.Heartbeat, function()
		if not soruAutoAimAtivo then return end
		local agora = os.clock()
		if agora - ultimoCalculo < 0.1 then return end
		ultimoCalculo = agora
		obterPosicaoSoru()
	end)

-- interface
	criarTitulo(paginaFull, "Soru Auto Aim", 15)

	criarToggle(paginaFull, "Soru Auto Aim", 16, function(on)
		soruAutoAimAtivo = on
		if not on then ultimaPos = nil end
		logar("info", on and ("Soru Auto Aim ativado (alcance " .. soruAlcance .. ").") or "Soru Auto Aim desativado.")
	end, false)

	criarSlider(paginaFull, "Distância Máx", 17, 100, 2000, soruAlcance, function(v)
		soruAlcance = v
	end, " studs")

	criarTitulo(paginaFull, "Alvo do Soru", 18)

	local lista = Instance.new("Frame")
	lista.Size = UDim2.new(1, 0, 0, 0)
	lista.AutomaticSize = Enum.AutomaticSize.Y
	lista.LayoutOrder = 19
	lista.BackgroundTransparency = 1
	lista.Parent = paginaFull

	local layoutLista = Instance.new("UIListLayout")
	layoutLista.Padding = UDim.new(0, 4)
	layoutLista.SortOrder = Enum.SortOrder.LayoutOrder
	layoutLista.Parent = lista

	local botoesLista = {}

	local function reconstruirLista()
		-- limpa botões antigos (e tira do registro de temas)
		for _, b in ipairs(botoesLista) do
			for i = #registroBotoes, 1, -1 do
				if registroBotoes[i].btn == b then table.remove(registroBotoes, i) end
			end
			b:Destroy()
		end
		table.clear(botoesLista)

		-- se o jogador escolhido saiu, volta pro automático
		if alvoEscolhido and not Players:FindFirstChild(alvoEscolhido) then
			alvoEscolhido = nil
		end

		local function adicionar(texto, nome, ordem)
			local selecionado = (alvoEscolhido == nome)
			local b = criarBotao(lista, (selecionado and "✓  " or "") .. texto, UDim2.new(1, 0, 0, 30), nil, ordem, false)
			registroBotoes[#registroBotoes].destaque = selecionado

			local tema = Temas[temaAtualNome]
			b.BackgroundColor3 = selecionado and tema.on or tema.item
			b.TextColor3 = selecionado and Color3.new(1, 1, 1) or tema.texto

			b.MouseButton1Click:Connect(function()
				alvoEscolhido = nome
				logar("info", nome and ("Alvo do Soru: " .. nome) or "Alvo do Soru: automático.")
				reconstruirLista()
			end)
			table.insert(botoesLista, b)
		end

		adicionar("Automático (por prioridade)", nil, 0)

		local nomes = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then table.insert(nomes, p) end
		end
		table.sort(nomes, function(a, b) return a.Name:lower() < b.Name:lower() end)

		for i, p in ipairs(nomes) do
			adicionar(p.DisplayName .. "  (@" .. p.Name .. ")", p.Name, i)
		end
	end

	conectar(Players.PlayerAdded, function() task.defer(reconstruirLista) end)
	conectar(Players.PlayerRemoving, function() task.defer(reconstruirLista) end)
	reconstruirLista()
end)()

----------------------------------------------------------------
-- FAST ATTACK (só Melee / Sword)
----------------------------------------------------------------
local pararFastAttack
;(function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local VirtualUser = game:GetService("VirtualUser")
	local LocalPlayer = player

	local RegisterAttack, RegisterHit = nil, nil
	local SendHitsToServer = nil

	local function carregarRemotes()
		pcall(function()
			local Net = ReplicatedStorage:WaitForChild("Modules", 5):WaitForChild("Net", 5)
			RegisterAttack = Net:FindFirstChild("RE/RegisterAttack")
			RegisterHit = Net:FindFirstChild("RE/RegisterHit")
		end)

		pcall(function()
			local ps = LocalPlayer:FindFirstChild("PlayerScripts")
			if ps then
				for _, s in pairs(ps:GetChildren()) do
					if s:IsA("LocalScript") then
						local ok, env = pcall(getsenv, s)
						if ok and env and env._G and env._G.SendHitsToServer then
							SendHitsToServer = env._G.SendHitsToServer
							break
						end
					end
				end
			end
		end)

		return true
	end

	local function copiaViva()
		return guiRaiz ~= nil and guiRaiz.Parent ~= nil
	end

	local disparos = 0
	local FastAttackEnabled = false
	local AttackRange = 80
	local AttackDelay = 0.0001

	local function GetTargets()
		local character = LocalPlayer.Character
		if not character then return {} end
		local myHRP = character:FindFirstChild("HumanoidRootPart")
		if not myHRP then return {} end

		local targets = {}

		local function add(model)
			local hum = model:FindFirstChildOfClass("Humanoid")
			local hrp = model:FindFirstChild("HumanoidRootPart")
			local head = model:FindFirstChild("Head") or model.PrimaryPart
			if hum and hrp and head and hum.Health > 0 then
				if (hrp.Position - myHRP.Position).Magnitude <= AttackRange then
					table.insert(targets, {model, head})
				end
			end
		end

		local enemies = workspace:FindFirstChild("Enemies")
		if enemies then
			for _, v in pairs(enemies:GetChildren()) do
				add(v)
			end
		end

		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				add(plr.Character)
			end
		end

		return targets
	end

	local function ForcarDano(targets)
		if #targets == 0 then return end
		local mainHead = targets[1][2]
		local character = LocalPlayer.Character
		local tool = character and character:FindFirstChildOfClass("Tool")
		if not tool then return end

		-- Bloqueia Fruit
		if tool.ToolTip == "Blox Fruit" or tool:GetAttribute("WeaponType") == "Demon Fruit" then
			return
		end

		-- Método interno do jogo
		if SendHitsToServer then
			pcall(function()
				SendHitsToServer(mainHead, targets)
			end)
		end

		-- RegisterAttack + RegisterHit
		if RegisterAttack and RegisterHit then
			pcall(function()
				RegisterAttack:FireServer(0)
				RegisterHit:FireServer(mainHead, targets)
			end)
			pcall(function()
				RegisterAttack:FireServer()
				RegisterHit:FireServer(mainHead, targets)
			end)
		end

		-- Ativa a tool + click
		pcall(function() tool:Activate() end)
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton1(Vector2.new(0, 0))
		end)

		disparos += 1
	end

	local function DoAttack()
		local character = LocalPlayer.Character
		if not character then return end
		if not character:FindFirstChildOfClass("Tool") then return end

		local targets = GetTargets()
		if #targets == 0 then return end

		ForcarDano(targets)
	end

	local geracao = 0
	local function iniciar()
		geracao += 1
		local minha = geracao
		FastAttackEnabled = true
		carregarRemotes()

		task.spawn(function()
			while geracao == minha and copiaViva() do
				if FastAttackEnabled then
					pcall(DoAttack)
				end
				task.wait(AttackDelay)
			end
		end)
	end

	local function parar()
		FastAttackEnabled = false
		geracao += 1
	end
	pararFastAttack = parar

	-- Status
	local statusCorpo = nil
	local statusAtivo = false

	local function iniciarStatus()
		if statusAtivo then return end
		statusAtivo = true
		task.spawn(function()
			local ultimo = disparos
			while statusAtivo and FastAttackEnabled and copiaViva() do
				task.wait(1)
				local porSeg = disparos - ultimo
				ultimo = disparos
