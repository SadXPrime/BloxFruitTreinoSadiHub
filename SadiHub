-- ABA SA BLACK LIST (teclas que o Silent Aim deve ignorar, por categoria)
----------------------------------------------------------------
;(function()
	local pagina = paginas["SA BLACK LIST"]

	local ORDEM_CATEGORIAS = { "Melee", "Fruit", "Sword", "Gun" }
	local TECLAS = {
		Melee = { "Z", "X", "C" },
		Fruit = { "Z", "X", "C", "V", "F", "TAP" },
		Sword = { "Z", "X" },
		Gun   = { "Z", "X" },
	}
	local TITULOS = { Melee = "Melees", Fruit = "Frutas", Sword = "Espadas", Gun = "Armas" }
	-- ToolTip da Tool equipada -> categoria
	local TOOLTIP_PARA_CATEGORIA = { Melee = "Melee", Sword = "Sword", Gun = "Gun", ["Blox Fruit"] = "Fruit" }

	local BlacklistedKeys = {}
	for cat, teclas in pairs(TECLAS) do
		BlacklistedKeys[cat] = {}
		for _, k in ipairs(teclas) do
			BlacklistedKeys[cat][k] = false
		end
	end

	-- seta a blacklist de uma tecla
	local function SetBlacklistKey(category, key, state)
		if BlacklistedKeys[category] and BlacklistedKeys[category][key] ~= nil then
			BlacklistedKeys[category][key] = state
		end
	end

	-- verifica se uma tecla está na blacklist
	local function IsKeyBlacklisted(category, key)
		return BlacklistedKeys[category] and BlacklistedKeys[category][key] or false
	end

	-- categoria da Tool que está na mão (Melee, Sword, Gun, Fruit) ou nil
	local function currentToolCategory()
		local char = player.Character
		local tool = char and char:FindFirstChildOfClass("Tool")
		return tool and TOOLTIP_PARA_CATEGORIA[tool.ToolTip] or nil
	end

	-- usada dentro do Silent Aim: a tecla está bloqueada pra arma atual?
	local function isKeyCurrentlyBlacklisted(key)
		if not key then return false end
		local cat = currentToolCategory()
		if cat and BlacklistedKeys[cat] and BlacklistedKeys[cat][key] ~= nil then
			return BlacklistedKeys[cat][key]
		end
		return false
	end

	-- deixa disponível pro seu Silent Aim (se o executor tiver getgenv)
	pcall(function()
		local env = getgenv and getgenv()
		if env then
			env.SABlacklist = {
				Set = SetBlacklistKey,
				IsBlacklisted = IsKeyBlacklisted,
				IsCurrentlyBlacklisted = isKeyCurrentlyBlacklisted,
				CurrentCategory = currentToolCategory,
				Keys = BlacklistedKeys,
			}
		end
	end)

	-- interface
	criarCartao(pagina, "SA BLACK LIST", "Teclas ligadas aqui são ignoradas pelo Silent Aim, de acordo com o tipo da arma na sua mão.", 0)

	local ordem = 1
	for _, cat in ipairs(ORDEM_CATEGORIAS) do
		criarTitulo(pagina, TITULOS[cat], ordem)
		ordem = ordem + 1

		for _, key in ipairs(TECLAS[cat]) do
			criarToggle(pagina, cat .. ": Blacklist " .. key, ordem, function(v)
				SetBlacklistKey(cat, key, v)
				logar("info", "SA Blacklist " .. cat .. " " .. key .. (v and ": ligada." or ": desligada."))
			end, false)
			ordem = ordem + 1
		end
	end
end)()

