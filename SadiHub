VFX.seletor = function(pai, ordem, opcoes, inicial, aoMudar)
	local linha = Instance.new("Frame")
	linha.Size = UDim2.new(1, 0, 0, 34)
	linha.LayoutOrder = ordem
	linha.BackgroundTransparency = 1
	linha.Parent = pai

	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal
	lay.Padding = UDim.new(0, 6)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = linha

	local regs, botoes = {}, {}
	local n = #opcoes
	local selecionado = inicial

	local function pintar()
		local tema = Temas[temaAtualNome]
		for i, b in ipairs(botoes) do
			local sel = (i == selecionado)
			regs[i].destaque = sel
			b.BackgroundColor3 = sel and tema.on or tema.item
			b.TextColor3 = sel and Color3.new(1, 1, 1) or tema.texto
		end
	end

	for i, nome in ipairs(opcoes) do
		local b = criarBotao(linha, nome, UDim2.new(1 / n, -(6 * (n - 1)) / n, 1, 0), nil, i, false)
		regs[i] = registroBotoes[#registroBotoes]
		botoes[i] = b
		b.MouseButton1Click:Connect(function()
			selecionado = i
			pintar()
			aoMudar(i, nome)
		end)
	end

	pintar()
	return linha
end

