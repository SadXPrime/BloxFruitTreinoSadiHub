local function arredondar(obj, raio)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, raio)
	c.Parent = obj
	return c
end

-- efeitos visuais (VFX): tabela compartilhada; as funções VFX.tema/abrir/aba são definidas mais abaixo
local VFX = {}
VFX.animUI = true      -- animações de interface (hover/pressionar/etc.)
VFX.extras = {}        -- UIStrokes extras que ganham o gradiente animado do tema

-- monta um ColorSequence com N cores espalhadas igualmente
VFX.seq = function(cores)
	local n = #cores
	if n == 1 then return ColorSequence.new(cores[1], cores[1]) end
	local pontos = {}
	for i, c in ipairs(cores) do
		table.insert(pontos, ColorSequenceKeypoint.new((i - 1) / (n - 1), c))
	end
	return ColorSequence.new(pontos)
end

-- degradê sutil que dá profundidade em cartões, toggles e sliders
VFX.prof = function(obj)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(212, 212, 224))
	g.Rotation = 90
	g.Parent = obj
end

